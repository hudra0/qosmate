config global 'global'
	option enabled '1'

config settings 'settings'
	option WAN 'wan'
	option LAN 'br-lan'
	option DOWNRATE '600000'
	option UPRATE '120000'
	option ROOT_QDISC 'cake'

config advanced 'advanced'
	option PRESERVE_CONFIG_FILES '1'
	option WASHDSCPUP '0'
	option WASHDSCPDOWN '0'
	option BWMAXRATIO '20'
	option ACKRATE ''
	option UDP_RATE_LIMIT_ENABLED '0'
	option TCP_UPGRADE_ENABLED '1'
	option TCP_DOWNPRIO_INITIAL_ENABLED '1'
	option TCP_DOWNPRIO_SUSTAINED_ENABLED '1'
	option UDPBULKPORT ''
	option TCPBULKPORT ''
	option VIDCONFPORTS ''
	option REALTIME4 ''
	option REALTIME6 ''
	option LOWPRIOLAN4 ''
	option LOWPRIOLAN6 ''
	option MSS '536'
	option NFT_HOOK 'prerouting'
	option NFT_PRIORITY '-160'
	option MAX_CONNECTIONS '0'
	option COMMON_LINK_PRESETS 'ethernet'
	option OVERHEAD ''
	option MPU ''
	option LINK_COMPENSATION ''
	option ETHER_VLAN_KEYWORD ''

config hfsc 'hfsc'
	option gameqdisc 'pfifo'
	option GAMEUP ''
	option GAMEDOWN ''
	option nongameqdisc 'fq_codel'
	option nongameqdiscoptions 'besteffort ack-filter'
	option MAXDEL '24'
	option PFIFOMIN '5'
	option PACKETSIZE '450'
	option netemdelayms '30'
	option netemjitterms '7'
	option netemdist 'normal'
	option pktlossp 'none'
	option netem_direction 'both'

config cake 'cake'
	option PRIORITY_QUEUE_INGRESS 'diffserv8'
	option PRIORITY_QUEUE_EGRESS 'diffserv8'
	option DUAL_CAKE '1'
	option LAN_BYPASS_LOCAL '1'
	option LAN_BYPASS_SUBNETS ''
	option USE_MQ '0'
	option HOST_ISOLATION '1'
	option NAT_INGRESS '1'
	option NAT_EGRESS '1'
	option ACK_FILTER_EGRESS 'auto'
	option RTT ''
	option AUTORATE_INGRESS '0'
	option EXTRA_PARAMETERS_INGRESS ''
	option EXTRA_PARAMETERS_EGRESS ''

config custom_rules 'custom_rules'

config autorate 'autorate'
	option enabled '0'
	option interval '500'
	option min_ul_rate ''
	option base_ul_rate ''
	option max_ul_rate ''
	option min_dl_rate ''
	option base_dl_rate ''
	option max_dl_rate ''
	option latency_increase_threshold '5'
	option latency_decrease_threshold '10'
	option reflectors '1.1.1.1 8.8.8.8 9.9.9.9'
	option refractory_increase '3'
	option refractory_decrease '1'
	option adjust_up_factor '102'
	option adjust_down_factor '85'
	option flash_history '0'
	option log_changes '0'

# Rules are evaluated on ingress (LAN -> WAN pre-proxy) and egress:
# QoSmate sets DSCP markings and stores them in conntrack for tc-ctinfo restoration.
# CAKE Diffserv8 (RFC 8290) prioritizes into 8 tins:
# Tin 7: Network Control (CS7, CS6)
# Tin 6: Realtime Gaming & Voice (EF, VA, CS5, CS4)
# Tin 5: Interactive Shell & Signaling (CS2)
# Tin 4: Low-Latency Data & Homelab (AF21, AF22, AF23)
# Tin 3: Video Streaming (CS3, AF41..43, AF31..33)
# Tin 2: Best Effort Web (CS0)
# Tin 1: High Throughput Bulk (AF11..13, CS1)
# Tin 0: Background Scavenger (LE)

config rule 'pc_gaming'
	option name 'PC Gaming UDP'
	option proto 'udp'
	option src_ip '10.10.10.182'
	option dest_port '!=53 !=80 !=443'
	option class 'cs5'
	option counter '1'
	option enabled '1'

config rule 'voice_webrtc'
	option name 'Discord Voice & WebRTC'
	option proto 'udp'
	option dest_port '50000-65535'
	option class 'va'
	option counter '1'
	option enabled '1'

config rule 'homelab_web'
	option name 'Homelab Web 8000'
	option proto 'tcp'
	option src_ip '10.10.10.182'
	option src_port '8000'
	option class 'af21'
	option counter '1'
	option enabled '1'

config rule 'bulk_downloads'
	option name 'P2P BitTorrent Bulk'
	option proto 'tcp udp'
	option dest_port '6881-6889'
	option class 'cs1'
	option counter '1'
	option enabled '1'

